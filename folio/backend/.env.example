# Keep real keys in backend/.env, never in frontend code or version control.
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.8-flash
# Cosine distance cutoff. Tune against your own evaluation questions.
RAG_MAX_DISTANCE=0.65
# Set true only when serving through HTTPS.
RAG_SECURE_COOKIES=false

# General LLM fallback when documents do not answer a question.
GENERAL_CHAT_ENABLED=true
